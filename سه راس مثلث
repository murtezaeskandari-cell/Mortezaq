import turtle

screen = turtle.Screen()
screen.bgcolor("white")

t = turtle.Turtle()
t.speed(3)
t.penup()
t.goto(0, 100)
t.pendown()

t.color("blue")
t.fillcolor("red")
t.begin_fill()
t.goto(-100, -70)
t.goto(100, -70)
t.goto(0, 100)
t.end_fill()

circles = [
    (0, 100, "white"),
    (-100, -70, "red"),
    (100, -70, "green")
]

for x, y, color in circles:
    t.penup()
    
    t.goto(x, y - 20) 
    t.pendown()
    t.color("red", color)
    t.begin_fill()
    t.circle(20)
    t.end_fill()

t.hideturtle()
turtle.done()